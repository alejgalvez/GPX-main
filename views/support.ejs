<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/png" href="/images/LogoGPX.png">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/support.css' />
</head>

<body class="support-page">
    <%- include('partials/header') %>

        <div class="hero-support">
            <div class="blob blob-1"></div>
            <div class="blob blob-2"></div>
            <div class="container" style="position: relative; z-index: 1;">
                <h1>Centro de ayuda</h1>
            </div>
        </div>

        <div class="support-content">
            <div class="container">
                <h2 class="section-title">Autoservicio</h2>

                <div class="autoservice-carousel-wrapper">
                    <div class="autoservice-grid">
                        <div class="service-card"><span class="service-icon">🔐</span> Restablecer 2FA</div>
                        <a href="/support/reset-password" class="service-card" style="text-decoration: none; color: inherit;"><span class="service-icon">🔑</span> Restablecer contraseña</a>
                        <a href="/support/change-email" class="service-card"
                            style="text-decoration: none; color: inherit;"><span class="service-icon">✉️</span>
                            Cambiar/Desvincular correo electrónico</a>
                        <a href="/support/change-phone" class="service-card" style="text-decoration: none; color: inherit;"><span class="service-icon">📱</span> Cambiar/Desvincular número de teléfono</a>
                        <a href="/support/reset-password" class="service-card"
                            style="text-decoration: none; color: inherit;"><span class="service-icon">🛡️</span> Cambiar
                            contraseña de inicio de sesión</a>
                        <a href="/support/freeze-account" class="service-card" style="text-decoration: none; color: inherit;"><span class="service-icon">🔒</span> Congelar cuenta</a>
                    </div>
                </div>

                <!-- Sección de preguntas frecuentes eliminada según petición del usuario -->

                <div class="contact-banner">
                    <h2>¿Aún tienes problemas?</h2>
                    <p>Brindamos servicio al cliente 24/7 que siempre satisface sus necesidades.</p>
                    <a href="/contact" class="btn btn-primary" style="background: #000; color: #fff;">Contáctenos →</a>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>

</body>

</html>